{
  "name": "geo-copilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.integration.config.ts",
    "gen:contracts": "node scripts/gen-contracts.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@turf/bbox": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/hex-grid": "^7.4.0",
    "@turf/points-within-polygon": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "dompurify": "^3.4.12",
    "lucide-react": "^1.50.0",
    "maplibre-gl": "^6.11.2",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.10.0",
    "terra-draw": "^1.35.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.27",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^24.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "json-schema-to-zod": "^2.8.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
