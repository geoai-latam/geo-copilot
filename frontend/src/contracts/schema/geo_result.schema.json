{
  "$defs": {
    "FeatureCollectionArtifact": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "pattern": "^(EPSG|OGC|ESRI|IAU_2015):[A-Za-z0-9_.]+$",
          "title": "Crs",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "kind": {
          "const": "feature_collection",
          "default": "feature_collection",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "crs",
        "data"
      ],
      "title": "FeatureCollectionArtifact",
      "type": "object"
    },
    "FeatureRefArtifact": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "crs": {
          "pattern": "^(EPSG|OGC|ESRI|IAU_2015):[A-Za-z0-9_.]+$",
          "title": "Crs",
          "type": "string"
        },
        "feature_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Count"
        },
        "format": {
          "enum": [
            "geoparquet",
            "flatgeobuf",
            "geojson"
          ],
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "const": "feature_ref",
          "default": "feature_ref",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "uri": {
          "pattern": "^(https?|s3|az|gs)://",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "format",
        "crs"
      ],
      "title": "FeatureRefArtifact",
      "type": "object"
    },
    "GeometryColumn": {
      "additionalProperties": false,
      "description": "Cómo viene la geometría en una tabla (MCP tabulares: Snowflake, Postgres…).\nLo declara el servidor o el adaptador G0→G1 (§3.5); nunca se adivina.",
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "crs": {
          "pattern": "^(EPSG|OGC|ESRI|IAU_2015):[A-Za-z0-9_.]+$",
          "title": "Crs",
          "type": "string"
        },
        "encoding": {
          "enum": [
            "wkb",
            "wkb_hex",
            "wkt",
            "geojson",
            "latlon"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "lat_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat Column"
        }
      },
      "required": [
        "column",
        "encoding",
        "crs"
      ],
      "title": "GeometryColumn",
      "type": "object"
    },
    "RasterTilesArtifact": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds",
          "type": "array"
        },
        "cog": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cog"
        },
        "crs": {
          "pattern": "^(EPSG|OGC|ESRI|IAU_2015):[A-Za-z0-9_.]+$",
          "title": "Crs",
          "type": "string"
        },
        "datetime": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datetime"
        },
        "kind": {
          "const": "raster_tiles",
          "default": "raster_tiles",
          "title": "Kind",
          "type": "string"
        },
        "legend": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legend"
        },
        "maxzoom": {
          "default": 22,
          "maximum": 24,
          "minimum": 0,
          "title": "Maxzoom",
          "type": "integer"
        },
        "minzoom": {
          "default": 0,
          "maximum": 24,
          "minimum": 0,
          "title": "Minzoom",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tiles": {
          "title": "Tiles",
          "type": "string"
        }
      },
      "required": [
        "name",
        "tiles",
        "crs",
        "bounds"
      ],
      "title": "RasterTilesArtifact",
      "type": "object"
    },
    "Stat": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Stat",
      "type": "object"
    },
    "StatsArtifact": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Stat"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "stats",
          "default": "stats",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "StatsArtifact",
      "type": "object"
    },
    "TableArtifact": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeometryColumn"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "table",
          "default": "table",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rows": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 10000,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "name",
        "columns",
        "rows"
      ],
      "title": "TableArtifact",
      "type": "object"
    }
  },
  "$id": "geo-copilot/geo_result/1.9.0",
  "additionalProperties": false,
  "description": "Lo que devuelve una tool geo-consciente.",
  "properties": {
    "artifacts": {
      "items": {
        "discriminator": {
          "mapping": {
            "feature_collection": "#/$defs/FeatureCollectionArtifact",
            "feature_ref": "#/$defs/FeatureRefArtifact",
            "raster_tiles": "#/$defs/RasterTilesArtifact",
            "stats": "#/$defs/StatsArtifact",
            "table": "#/$defs/TableArtifact"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/FeatureCollectionArtifact"
          },
          {
            "$ref": "#/$defs/FeatureRefArtifact"
          },
          {
            "$ref": "#/$defs/RasterTilesArtifact"
          },
          {
            "$ref": "#/$defs/TableArtifact"
          },
          {
            "$ref": "#/$defs/StatsArtifact"
          }
        ]
      },
      "title": "Artifacts",
      "type": "array"
    },
    "facts": {
      "additionalProperties": true,
      "title": "Facts",
      "type": "object"
    },
    "geo_result": {
      "const": "1",
      "default": "1",
      "title": "Geo Result",
      "type": "string"
    },
    "style_hint": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Style Hint"
    }
  },
  "title": "GeoResult",
  "type": "object"
}
