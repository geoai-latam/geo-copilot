# GEO_COPILOT Frontend Environment Variables
# Copy this file to .env.local and customize values

# API Configuration
VITE_API_BASE=/api/v1
# Clave de API para el backend (X-API-Key); opcional (dev sin auth / proxy).
VITE_API_KEY=
VITE_API_TIMEOUT=30000

# Map Configuration (Bogotá defaults)
VITE_MAP_CENTER_LON=-74.0721
VITE_MAP_CENTER_LAT=4.7110
VITE_MAP_ZOOM=100000
