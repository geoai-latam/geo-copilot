# =============================================================================
# GEO_COPILOT — variables de PRODUCCIÓN (F7). Copiar a `.env.production` en la VM y rellenar.
# NUNCA se versiona el .env.production (tiene secretos). Guía: docs/sistema/19-despliegue-produccion.md
#
# Todo lo que hay que rellenar lleva un marcador `__RELLENAR…__`. Comprobar que no queda ninguno:
#   grep -nE '__[A-Z_]+__' .env.production        (sin salida)
# Generar cada secreto aleatorio con:   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
#
# Este archivo es el `--env-file` del compose: sirve para INTERPOLAR docker/*.yml. La app no lo
# recibe entero: solo las variables que docker-compose.prod.yml le pasa (servicio `app`).
# =============================================================================

# --- Versión desplegada (imágenes del registro, publicadas por el CI al etiquetar vX.Y.Z) -------
IMAGEN_PREFIJO=ghcr.io/geoai-latam/geo-copilot
VERSION=1.0.0

LOG_LEVEL=INFO
LOG_FORMAT=json
# procesos de cada réplica de la app y número de réplicas (nginx reparte; el estado va por Redis)
WEB_CONCURRENCY=2
APP_REPLICAS=1

# --- Base de datos (PostGIS del stack; usuario `geo_user` y BD `geo_copilot`, fijos) ---------------
# contraseña del SUPERUSUARIO (inicialización y migraciones; la app nunca la recibe)
POSTGRES_PASSWORD=__RELLENAR__
# la app se conecta con este rol NO superusuario (init-db/04)
GEO_APP_PASSWORD=__RELLENAR__
# opcional: rol de solo lectura del servidor MCP de SQL (init-db/08), solo si se activa postgis-mcp
MCP_SQL_LECTOR_PASSWORD=

# --- Redis (obligatorio en producción: sesiones, aprobaciones, límites, bus entre workers) --------
REDIS_PASSWORD=__RELLENAR__

# --- Modelo de lenguaje (ver «Cómo enchufar otro modelo» en docs/validacion/AUDITORIA_PRE_PRODUCCION)
LLM_PROVIDER=azure
LLM_MODEL=gpt-5.4
AZURE_OPENAI_API_KEY=__RELLENAR__
AZURE_OPENAI_ENDPOINT=https://__RELLENAR_RECURSO__.openai.azure.com/
OPENAI_API_VERSION=2024-12-01-preview
# segundos DE RELOJ que cada llamada al LLM espera a un proveedor saturado (429 por límite de tasa)
# antes de rendirse; nunca más allá del plazo del turno (TOTAL_EXECUTION_TIMEOUT). Un 429
# `insufficient_quota` (saldo o cuota de facturación agotados) no se espera: falla al momento.
# No sustituye a DIMENSIONAR la cuota del deployment (tokens/min): medirla con
# `scripts/prueba_carga.py` contra este despliegue. Esa prueba consulta las manzanas del
# catastro de ejemplo (sin él, adaptar su mezcla a los datos de la organización) y necesita una
# identidad INDEPENDIENTE por usuario simulado: un JWT de OIDC por usuario en CARGA_TOKENS (que
# duren la corrida). La app tiene UNA API key: con ella (API_KEY) todos los usuarios simulados son
# el mismo principal y comparten UN cupo; el script lo avisa (ver su encabezado)
LLM_ESPERA_SATURACION_S=60
# plazo de un turno en segundos (30–600, por defecto 120); con aprobación humana se suma
# HITL_TIMEOUT. nginx espera 480 s a /api/: si la suma pasa de ~450, ver el runbook (paso 5)
# TOTAL_EXECUTION_TIMEOUT=120
# LLM_MODEL_PROFILE={"reasoning": true, "supports_temperature": false, "max_tokens_param": "max_completion_tokens"}
# presupuesto de tokens por turno (0 = sin tope): ponerlo en producción
REACT_TOKEN_BUDGET=200000

# --- Identidad (OIDC del proveedor de la organización) -------------------------------------------
# El token de ACCESO que manda el navegador tiene que ser un JWT con `aud` = OIDC_AUDIENCE y los
# claims de organización y de rol (docs/sistema/18-identidad-y-organizaciones.md).
# URL PÚBLICA del emisor, exactamente el `iss` de los tokens:
#   Keycloak: https://<host>/realms/<realm>
#   Entra ID: https://login.microsoftonline.com/<tenant>/v2.0 — solo si el manifiesto de la API
#   tiene `accessTokenAcceptedVersion: 2`; si no, Entra emite tokens v1.0 y su `iss` es
#   https://sts.windows.net/<tenant>/ (emisor y audiencia van en pareja: ver OIDC_AUDIENCE)
OIDC_ISSUER=__RELLENAR_EMISOR__
# opcional: claves públicas (JWKS) del proveedor. Vacía = la `jwks_uri` del descubrimiento
# (<OIDC_ISSUER>/.well-known/openid-configuration), que sirve en Keycloak, Entra ID y Google. Solo
# hace falta si la API no alcanza la URL pública del emisor (fijarla entonces a la interna).
# OIDC_JWKS_URL=
# cliente público (PKCE) del navegador
OIDC_CLIENT_ID=geo-copilot-web
# la audiencia que lleva el token (se valida estricta: si no casa, 401 a todo). El realm de
# referencia (docker/keycloak/geo-realm.json) añade `geo-copilot-api` con un audience-mapper.
# Entra ID, según la versión del token (la del emisor de arriba):
#   v2.0 (…/<tenant>/v2.0):            el Application (client) ID de la API, un GUID
#   v1.0 (https://sts.windows.net/…/): el Application ID URI de la API (`api://…`)
OIDC_AUDIENCE=geo-copilot-api
# dónde vienen la organización y los roles (ruta con puntos). Keycloak de referencia: `org` y
# `realm_access.roles`; Entra ID: `tid` (el inquilino) y `roles` (roles de aplicación)
OIDC_ORG_CLAIM=org
OIDC_ROLES_CLAIM=realm_access.roles
# origen del IdP para la CSP del frontend (connect-src), p. ej. https://login.microsoftonline.com
OIDC_ORIGEN=__RELLENAR_ORIGEN_IDP__
# organización que administra la plataforma (re-aprueba las herramientas de la plataforma): el
# valor de su claim de organización
ORG_PLATAFORMA=__RELLENAR_ORG__
# opcional, solo si se registra un servidor MCP con `auth: token_exchange` (F6; los de la
# plataforma usan clave): secreto del cliente confidencial de la API en el IdP y su endpoint de
# token (vacío = el `token_endpoint` del descubrimiento, como OIDC_JWKS_URL)
KC_API_CLIENT_SECRET=
# OIDC_TOKEN_URL=

# --- Conexiones MCP por organización (F6) --------------------------------------------------------
# clave maestra de los secretos de conexiones (32 bytes en base64): openssl rand -base64 32
SECRETS_KEK=__RELLENAR__
# hosts internos que una organización puede conectar (vacío = solo destinos públicos)
MCP_HOSTS_PERMITIDOS=

# --- Servicios MCP de la plataforma: la clave que usa la app y la lista que acepta el servicio ------
# La clave se escribe UNA vez (…_APP_KEY); la lista (…_KEYS) la toma de ahí al interpolar
# (`${…}`), con los scopes que el servicio exige (sin ellos: 403).
IMAGERY_MCP_APP_KEY=__RELLENAR__
IMAGERY_MCP_KEYS=[{"name":"geo-copilot-app","key":"${IMAGERY_MCP_APP_KEY}","scopes":["imagery:read","imagery:compute"],"rate_limit_per_min":120}]
ARCGIS_MCP_APP_KEY=__RELLENAR__
ARCGIS_MCP_KEYS=[{"name":"geo-copilot-app","key":"${ARCGIS_MCP_APP_KEY}","scopes":["arcgis:read"],"rate_limit_per_min":240}]
ARCGIS_ALLOWED_DOMAINS=arcgis.com,arcgisonline.com
# Geocodificación (lugares-mcp). Con tráfico real, un Nominatim propio: el público pide identificarse
# (User-Agent con contacto) y no más de 1 petición por segundo.
LUGARES_MCP_APP_KEY=__RELLENAR__
LUGARES_MCP_KEYS=[{"name":"geo-copilot-app","key":"${LUGARES_MCP_APP_KEY}","scopes":["lugares:read"],"rate_limit_per_min":120}]
LUGARES_NOMINATIM_URL=https://nominatim.openstreetmap.org
LUGARES_USER_AGENT=geo-copilot/1.0 (__RELLENAR_CONTACTO__)

# --- Frontend (nginx con TLS) ---------------------------------------------------------------------
# certificado de la organización en docker/certs/ (tls.crt + tls.key)
FRONTEND_BIND=0.0.0.0
CORS_ORIGINS=["https://__RELLENAR_DOMINIO__"]

# --- Aprobación humana ----------------------------------------------------------------------------
HITL_ENABLED=true
# segundos que un turno espera a que alguien apruebe (se suman al plazo del turno; ver arriba)
HITL_TIMEOUT=300

# --- Observabilidad (vacío = apagado) -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
# muestreo de trazas (por defecto, todas): p. ej. parentbased_traceidratio con 0.2
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2
SENTRY_DSN=
