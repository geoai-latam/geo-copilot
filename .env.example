# GEO_COPILOT - Variables de Entorno
# Copiar este archivo a .env y configurar los valores

# =============================================================================
# APLICACIÓN
# =============================================================================
APP_NAME=GEO_COPILOT
APP_VERSION=0.1.0
DEBUG=false
# ENVIRONMENT es el interruptor maestro de seguridad, no una etiqueta. Con un
# valor no-prod (development, dev, local, test, testing) el backend arranca sin
# API_KEY, publica /docs y /openapi.json, acepta SANDBOX_BACKEND=subprocess y
# no exige token en el WebSocket. Con cualquier otro valor exige las cuatro.
# Auditoría 2026-09-08 (§7 punto 8): el DEFAULT del código es 'production', o
# sea que OLVIDAR esta variable ya no abre la API — falla del lado seguro. Por
# eso aquí va DECLARADA en 'development': este archivo es el quickstart local.
# Al desplegar, cámbiala a 'production' y define API_KEY, o el arranque se
# rechaza (fail-closed). Y con ENVIRONMENT=production, DEBUG debe ser false:
# el guard `enforce_production_debug` rehúsa arrancar con las dos a la vez,
# porque en debug el saneador anexa la traza cruda a las respuestas de error.
ENVIRONMENT=development

# =============================================================================
# SEGURIDAD / SECRETOS (RUN — auditoría). En prod, DEFINIR estos; los defaults
# de dev del docker-compose NO deben usarse en producción.
# =============================================================================
# F6 — IDENTIDAD (docs/sistema/18-identidad-y-organizaciones.md).
# Personas por OIDC: el `iss` PÚBLICO del proveedor. Vacío = sin login (solo dev: un
# usuario `dev` administrador). En desarrollo, el Keycloak del perfil `auth`:
#   docker compose -f docker/docker-compose.yml --env-file .env --profile auth up -d keycloak
# OIDC_ISSUER=http://localhost:8081/realms/geo
# Dentro del compose, la API pide las claves (JWKS) y el token exchange al Keycloak por la red
# interna (keycloak:8080, el valor por defecto). Con otro proveedor en desarrollo, sus URL:
# OIDC_JWKS_URL_INTERNA=
# OIDC_TOKEN_URL_INTERNA=
# (Producción no usa estas dos: OIDC_JWKS_URL/OIDC_TOKEN_URL en .env.production.example.)
# Keycloak de desarrollo: contraseña de los usuarios de prueba (ana, beto, carla, diego),
# secreto del cliente de la API (token exchange) y admin de la consola.
# KC_DEV_PASSWORD=
# KC_API_CLIENT_SECRET=
# KEYCLOAK_ADMIN_PASSWORD=
# Clave maestra (32 bytes base64) de las credenciales de las conexiones de organización:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# SECRETS_KEK=
# Hosts internos que una organización puede usar en sus conexiones (si no, solo https público).
# MCP_HOSTS_PERMITIDOS=almacen-demo,archivos-mcp,hello-geo
# La organización que re-aprueba las herramientas de la PLATAFORMA (vacío = cualquier admin).
# ORG_PLATAFORMA=acme
# API key: SOLO clientes de servicio (scripts, CI), con su organización y rol. El navegador
# nunca la lleva (nginx ya no la inyecta). Vacía/ausente y sin OIDC = sin auth (solo dev).
# API_KEY=cambia-esto-en-prod
# API_KEY_ORG=default
# API_KEY_ROLE=admin
# Password del SUPERUSUARIO de Postgres (`geo_user`): inicialización y
# mantenimiento. La aplicación NO se conecta con este rol — ver GEO_APP_PASSWORD.
# R0.3 (auditoría 2026-07-26, AUD-05): YA NO ES OPCIONAL. docker-compose la
# declara `${POSTGRES_PASSWORD:?}`, así que sin ella el stack NO arranca. Antes
# caía al literal `secure_password`, que está publicado en este repositorio.
# Va COMENTADA a propósito: un valor asignado aquí satisface el `:?` y hace que
# `cp .env.example .env && docker compose up` arranque con una contraseña que
# está publicada en GitHub — que es exactamente lo que R0.3 vino a impedir.
# POSTGRES_PASSWORD=
# Password del rol de aplicación `geo_app` (NOSUPERUSER, miembro de
# gis_readonly). R0.6 (AUD-04): es con ESTE rol con el que se conecta la app,
# porque `geo_user` es superusuario en la imagen postgis y una transacción
# READ ONLY no contiene a un superusuario. La consumen dos servicios del
# compose: `postgis` (para que init-db/05 la aplique con ALTER ROLE) y `app`
# (dentro del DATABASE_URL). Tienen que ser la misma.
# GEO_APP_PASSWORD=
# Opcional: clave del rol de solo lectura `mcp_lector` del servidor MCP de SQL (postgis-mcp,
# perfil `connectors`). El compose la pasa a `postgis` (init-db/08 crea el rol al inicializar)
# y a `postgis-mcp`. BD ya creada: docker/migrations/2026-09-27_mcp_lector.sh
# MCP_SQL_LECTOR_PASSWORD=
# Clave con la que la app se autentica ante el servicio imagery-mcp (Bearer).
# DENTRO del compose es ESTA la variable que se lee (docker-compose.yml, en el
# servicio `app`, la inyecta como IMAGERY_MCP_API_KEY); fuera del compose
# la que lee el código es IMAGERY_MCP_API_KEY — ver la sección IMAGERY abajo.
# Auditoría 2026-09-08 (§3): ANTES caía al literal `dev-imagery-key`, que está
# publicado en este repositorio. Ahora el compose la declara `:?`, así que sin
# ella el stack NO arranca. Va COMENTADA por la misma razón que las dos de
# arriba: un valor asignado aquí satisface el `:?` y hace que
# `cp .env.example .env && docker compose up` levante el MCP con una clave
# publicada en GitHub. Genera una local: `openssl rand -hex 24`.
# IMAGERY_MCP_APP_KEY=
# Claves que el servicio imagery-mcp ACEPTA (JSON en una línea). Es el otro
# lado de la anterior: el `key` de este JSON tiene que ser EXACTAMENTE el
# valor de IMAGERY_MCP_APP_KEY, o las teselas NDVI dan 401. El servicio rehúsa
# arrancar si esta variable está vacía, y el compose la declara `:?` por la
# misma razón que la de arriba: su default traía `dev-imagery-key` dentro.
# Scopes: `imagery:read` (STAC/metadatos) e `imagery:compute` (NDVI, cambio,
# zonal). `rate_limit_per_min` acota el gasto de una clave comprometida.
# IMAGERY_MCP_KEYS=[{"name":"geo-copilot-app","key":"EL_MISMO_DE_IMAGERY_MCP_APP_KEY","scopes":["imagery:read","imagery:compute"],"rate_limit_per_min":120}]
# Servidor MCP de ArcGIS (F5, T5.2): el discovery (buscar en ArcGIS Hub, cargar capas) va por
# él. La app se autentica con ARCGIS_MCP_APP_KEY; el servicio acepta las de ARCGIS_MCP_KEYS (el
# `key` tiene que ser el mismo). Sin ellas el stack no arranca. Genera una: `openssl rand -hex 24`.
# ARCGIS_MCP_APP_KEY=
# ARCGIS_MCP_KEYS=[{"name":"geo-copilot-app","key":"EL_MISMO_DE_ARCGIS_MCP_APP_KEY","scopes":["arcgis:read"],"rate_limit_per_min":240}]
# lugares-mcp (geocodificación sobre Nominatim/OSM): misma idea de claves. En producción, un
# Nominatim propio (LUGARES_NOMINATIM_URL) y un User-Agent con contacto (política de uso de OSM).
# LUGARES_MCP_APP_KEY=
# LUGARES_MCP_KEYS=[{"name":"geo-copilot-app","key":"EL_MISMO_DE_LUGARES_MCP_APP_KEY","scopes":["lugares:read"],"rate_limit_per_min":120}]
# LUGARES_NOMINATIM_URL=https://nominatim.openstreetmap.org
# LUGARES_USER_AGENT=geo-copilot/1.0 (contacto@tu-dominio)
# Opcional: restringir los servicios ArcGIS que se pueden pedir a estos dominios (coma).
# ARCGIS_ALLOWED_DOMAINS=arcgis.com,igac.gov.co

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Provider: openai, anthropic, azure, local
LLM_PROVIDER=azure

# -----------------------------------------------------------------------------
# OpenAI (si LLM_PROVIDER=openai)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
# Modelos: gpt-4.1, gpt-4.1-mini, gpt-4o, o4-mini, gpt-5… (los de razonamiento se detectan solos)

# -----------------------------------------------------------------------------
# Anthropic (si LLM_PROVIDER=anthropic)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# Modelos: claude-sonnet-5, claude-opus-5-5, claude-haiku-4-5… (temperatura/forzado según el modelo)

# -----------------------------------------------------------------------------
# Azure OpenAI (si LLM_PROVIDER=azure)
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
OPENAI_API_VERSION=2024-12-01-preview
# El modelo se configura en LLM_MODEL abajo

# -----------------------------------------------------------------------------
# Modelo a usar (aplica para todos los providers)
# -----------------------------------------------------------------------------
# Para Azure: nombre del DEPLOYMENT (ej: gpt-4.1-mini). Si detrás hay un modelo que razona
# (o-series, gpt-5), decláralo en LLM_MODEL_PROFILE: el nombre del deployment no lo dice.
# 2026-10-05: gpt-5.4 — batería de verdades ×5 92,59 % vs 82,96 % de gpt-4.1-mini, con −20 % llamadas
# y −23 % tokens de entrada por pregunta (docs/validacion/F3_MODELOS_2026-10-05.md)
LLM_MODEL=gpt-5.4
# Rasgos del modelo que mandan sobre la inferencia (JSON; campos de core/model_profile.py):
# LLM_MODEL_PROFILE={"reasoning": true, "supports_temperature": false, "max_tokens_param": "max_completion_tokens", "min_output_tokens": 8192}
LLM_MODEL_PROFILE=
LLM_MAX_RETRIES=2

# Servidor compatible con la API de OpenAI (vLLM, Ollama, LM Studio, gateway):
# LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:14b
LLM_BASE_URL=
LLM_API_KEY=

# =============================================================================
# DATABASE - PostGIS
# =============================================================================
# Sólo para correr el backend FUERA del compose. Dentro del compose el
# DATABASE_URL se construye a partir de GEO_APP_PASSWORD; ver docker-compose.yml.
# R0.6 (AUD-04): el usuario es `geo_app`, NO `geo_user`. `geo_user` es
# superusuario en la imagen postgis, y una transacción READ ONLY no contiene a
# un superusuario: `pg_read_file('/etc/passwd')` y los hashes de `pg_authid`
# quedaban al alcance del SQL que escribe el LLM.
# Nota: el puerto es 5433 si el PostGIS lo levantó el compose (ver README).
DATABASE_URL=postgresql://geo_app:LA_MISMA_DE_GEO_APP_PASSWORD@localhost:5433/geo_copilot
# OJO: esta variable NO SE LEE en ninguna parte del código (verificado en la
# auditoría 2026-09-08). La lectura-sólo real la impone la transacción
# `BEGIN READ ONLY` + `SET LOCAL ROLE gis_readonly` de gis_agent/agent.py.
# Se deja documentada como pendiente: o se cablea, o se borra.
DATABASE_READ_ONLY=true

# =============================================================================
# REDIS CACHE
# =============================================================================
# R0.3 (auditoría 2026-07-26, AUD-05): OBLIGATORIA. docker-compose la usa para
# `redis-server --requirepass` y el arranque FALLA si no está definida. Antes no
# existía ninguna credencial de Redis en el repo y el puerto salía a 0.0.0.0:
# cualquiera en la red leía o borraba el historial conversacional de todos los
# usuarios (`geocopilot:session:*`) sin presentar credencial.
# Comentada por la misma razón que POSTGRES_PASSWORD: un valor asignado aquí
# satisface el `${REDIS_PASSWORD:?}` del compose y arranca Redis con una
# contraseña publicada en este repositorio.
# REDIS_PASSWORD=
# Para uso fuera de docker-compose. Dentro del compose se construye a partir de
# REDIS_PASSWORD; ver docker/docker-compose.yml.
REDIS_URL=redis://:LA_MISMA_DE_REDIS_PASSWORD@localhost:6379/0
CACHE_TTL=3600
# Dónde viven las sesiones (historial conversacional). 'memory' es el default
# del código: se pierde al reiniciar y NO sirve con más de un worker, porque
# cada proceso tendría su propio diccionario y una sesión "desaparecería" según
# a qué worker cayera la petición. Pon 'redis' en cuanto corras con réplicas o
# quieras que la conversación sobreviva a un `docker compose restart`.
SESSION_BACKEND=memory

# =============================================================================
# SECURITY
# =============================================================================
# R0.7 (auditoría 2026-07-26, AUD-04): validación ESTRUCTURAL del SQL del LLM.
#   off     -> desactivada
#   shadow  -> analiza y REGISTRA que rechazaria, SIN bloquear
#   enforce -> bloquea (default), incluida la allowlist de tablas del semantic layer
# Usa `shadow` solo para medir contra una BD o un modelo nuevos: revisa los logs
# `[SQL-AST][SOMBRA]` y vuelve a `enforce`.
SQL_AST_VALIDATION=enforce

# Dónde se EJECUTA el código Python que escribe el LLM. Es la frontera de
# seguridad más importante de todo el sistema, no un detalle de rendimiento.
#   docker      -> `docker exec` contra el contenedor `sandbox` (network:none,
#                  read_only, cap_drop:ALL, non-root). Es el default del código
#                  y el único que contiene de verdad. Necesita el stack de
#                  docker-compose levantado (el contenedor `sandbox` y el
#                  docker-socket-proxy).
#   subprocess  -> child dentro del propio proceso de la API, con DATABASE_URL,
#                  las claves del LLM y DOCKER_HOST en el entorno. El filtro AST
#                  que lo "protege" se evade con `json.__builtins__` (verificado).
#                  SOLO desarrollo, y el arranque lo rehúsa si ENVIRONMENT no es
#                  de desarrollo (api/auth.py: enforce_sandbox_backend).
# En Windows 'subprocess' tampoco sirve: los rlimits son POSIX, así que
# sandbox.py lo rechaza y la capacidad de Python se declara no disponible. Para
# tenerla en Windows: WSL2, o Docker Desktop con el stack de compose.
SANDBOX_BACKEND=docker

# ¿Confiar en X-Forwarded-For para identificar al cliente en el rate-limit?
# Actívalo SOLO si la app está detrás de un proxy/LB de confianza que SETEA
# ese header (lo pisa, no lo reenvía). Con true y sin ese proxy, cualquiera
# manda un XFF inventado en cada petición y el rate-limit deja de existir.
TRUST_PROXY_HEADERS=false

HITL_ENABLED=true
HITL_TIMEOUT=300
MAX_QUERY_RESULTS=1000
# Mecanismo del Human-in-the-Loop. 'blocking' es el de producción y el que
# está probado: el grafo se detiene en un asyncio.Event hasta que llega la
# aprobación por REST/WebSocket. 'interrupt' es el spike con
# LangGraph interrupt()+checkpointer, EXPERIMENTAL y con el cutover diferido.
# Ojo al efecto lateral: con 'interrupt' el enrutado ReAct híbrido se apaga
# solo y las consultas vuelven al planner multi-paso.
HITL_MODE=blocking

# =============================================================================
# ORQUESTACIÓN (qué camino toma una consulta)
# =============================================================================
# Con estos dos valores por defecto, una consulta COMPLEJA va al bucle ReAct y
# una simple al grafo cableado. Cambiarlos cambia el comportamiento del sistema
# entero, así que están aquí y no enterrados en el código.
#   off     -> nunca ReAct: siempre el grafo cableado (rollback sin redeploy).
#   hybrid  -> el router decide (default; benchmark A1 sobre 32 tareas con LLM
#              real: mismo acierto que 'off', 93.33%, y 6.4 s de latencia
#              mediana frente a 6.8 s).
#   always  -> todo al bucle ReAct.
REACT_POLICY=hybrid
# Auto-corrección: si un agente falla, reintenta con el error como contexto en
# vez de devolver el fallo. En false el flujo es de un solo intento — más
# barato y más predecible para depurar, peor para el usuario final.
AUTONOMOUS_MODE=true

# =============================================================================
# IMAGERY (Sentinel-2 / NDVI) — servicio imagery-mcp
# =============================================================================
# Sin estas dos, la capacidad de imágenes satelitales se declara NO disponible
# y el sistema responde honestamente que no puede hacerlo. No hay error ni
# aviso en el arranque: simplemente falta la mitad de lo que promete el README.
# DENTRO del compose las inyecta docker-compose.yml (IMAGERY_MCP_URL apunta al
# servicio interno y la clave sale de IMAGERY_MCP_APP_KEY, arriba). Esta
# sección es para correr el backend FUERA de Docker contra un MCP ya levantado.
# IMAGERY_MCP_URL=http://localhost:9100/mcp
# Bearer con el que la app llama al MCP. Comentada por la misma convención que
# el resto de secretos: tiene que coincidir con una de las IMAGERY_MCP_KEYS.
# IMAGERY_MCP_API_KEY=
# Catálogo del que el MCP baja las escenas. 'planetary-computer' (Microsoft) o
# 'earth-search' (Element84/AWS). Lo lee el servicio, no la app.
IMAGERY_PROVIDER=planetary-computer

# =============================================================================
# EXTERNAL APIS
# =============================================================================

# Orígenes permitidos para CORS (formato JSON, una sola línea).
# En dev incluye los puertos donde corre el frontend; en prod pon la
# URL pública. NO uses ['*'] si CORS_ALLOW_ALL=false con credentials.
# Puerto del contenedor frontend (docker compose). Si Langfuse local ocupa el 3000, usa 3001.
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8080","http://127.0.0.1:3000","http://localhost:5173"]
CORS_ALLOW_ALL=false

# Dominios permitidos para fetch externo y scraping (SSRF whitelist).
ALLOWED_DOMAINS=["datos.gov.co","www.datos.gov.co","mapas.parquesnacionales.gov.co","geoservicios.esri.co","geoservicios.upra.gov.co","mapas2.igac.gov.co","mapas.igac.gov.co","geoportal.igac.gov.co","geoportal.dane.gov.co","www.dane.gov.co","geovisor.anh.gov.co","geo.anm.gov.co","visualizador.ideam.gov.co","hermes.invias.gov.co","gisart.renovacionterritorio.gov.co","portalsig.anla.gov.co","srvags.sgc.gov.co","serviciosgis.catastrobogota.gov.co","secretariadeambiente.gov.co","portalgis.habitatbogota.gov.co","sig.simur.gov.co","sigau.jbb.gov.co","www.acueducto.com.co","oaiee.scj.gov.co","sigmzl.manizales.gov.co","idep.palmira.gov.co","sia.cortolima.gov.co","www.geo.cvc.gov.co","services.arcgis.com","services1.arcgis.com","services2.arcgis.com","services3.arcgis.com","services7.arcgis.com","services9.arcgis.com","arcgis.com"]

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=text

# =============================================================================
# PATHS
# =============================================================================
SEMANTIC_LAYER_PATH=semantic_layer/entities.yaml

# === hello-geo (servidor GeoMCP de EJEMPLO, perfil 'examples') ===
# Solo si quieres probar el enchufe de un MCP (docker compose --profile examples up -d hello-geo).
# HELLO_GEO_APP_KEY=
# HELLO_GEO_KEYS='[{"name":"app","key":"EL_MISMO_DE_HELLO_GEO_APP_KEY","scopes":["hello:use"],"rate_limit_per_min":120}]'
