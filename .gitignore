# Dumps reales de la BD — pesados (~500MB), NO commitear.
# El usuario los pone localmente en docker/init-db/ para cargar como seed
# del compose principal. Ver docker/init-db/README.md.
docker/init-db/*_real.sql
docker/init-db/*_real.dump
docker/init-db/*.dump
docker/init-db/geocopilot.sql

# Cassettes VCR temporales / sin commitear (las definitivas SÍ van al repo).
tests/fixtures/cassettes/*.tmp.yaml

# CA corporativa opcional para Dockerfile.frontend (TLS interceptor).
# Si tu red corporativa rompe ``npm ci``, exporta tu CA aquí y el build
# la inyectará como NODE_EXTRA_CA_CERTS. Nunca commitear.
docker/corporate-ca.pem
# F6: certificados TLS del frontend (el de desarrollo lo genera el contenedor)
docker/certs/

# Claude Code runtime state (locks, scheduled tasks, etc.) — local-only.
.claude/scheduled_tasks.lock
# Permisos/ajustes personales por-máquina (Claude Code los genera por usuario).
.claude/settings.local.json
# El directorio entero: `.claude/agents/*.md` son herramientas internas de
# desarrollo, no parte del producto. Sin esta línea un `git add -A` las
# publica sin que nadie lo decida.
.claude/

# F3: registro local de servidores MCP (dev); el del repo es config/mcp_servers.yaml
config/mcp_servers.local.yaml
tests/deixis_bench/ultimo_informe.json

# F7: variables de producción (secretos). Se versiona solo la plantilla .env.production.example
.env.production

# F7 (auditoría): las corridas de la prueba de carga (scripts/prueba_carga.py) son locales; la
# válida se copia como evidencia a docs/validacion/evidencia/fase-7/ y se cita en el acta. Así una
# corrida inválida (p. ej. la interrumpida por la suspensión del equipo) no entra con un `git add -A`.
bench_results/carga*.json

# Material interno de trabajo: no se publica (queda en local).
# Validaciones con capturas y trazas de sesiones, auditorías de seguridad, planes, backlog,
# documentos archivados y resultados del banco agéntico (respuestas del modelo).
docs/validacion/
docs/archive/
docs/AUDITORIA_*.md
docs/PLAN_*.md
docs/TAREAS_*.md
docs/BACKLOG.md
bench_results/
.gitleaks-report.json
